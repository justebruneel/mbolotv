# Port d'écoute du transcodeur
# HOST=0.0.0.0 requis pour que le conteneur API atteigne le transcodeur via
# la passerelle du bridge Docker (firewalld bloque le LAN externe de fait).
PORT=8090
HOST=0.0.0.0

# Token partagé pour les routes de contrôle (/start, /stop, /status).
# Doit être identique à ECO_TRANSCODER_TOKEN côté API. Vide = pas d'auth (dev).
ECO_TOKEN=change-me-eco-token

# Racine HLS (segments éphémères). Droits d'écriture requis.
HLS_ROOT=/var/lib/mbolo-eco

# Arrêt automatique après cette durée sans requête de lecture
IDLE_TIMEOUT_MS=300000

# Nombre max de ffmpeg simultanés : ~1 cœur CPU chacun.
# 2 sur le Celeron 3205U ; 10-20 sur un VPS.
MAX_STREAMS=2

READY_WAIT_MS=10000
FFMPEG_BIN=ffmpeg
