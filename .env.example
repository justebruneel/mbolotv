# Application
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000

# Sécurité — remplacer ces valeurs hors développement
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ENCRYPTION_KEY=32-byte-base64-key-change-me

# Base de données
# Dev : SQLite, aucune infrastructure requise
DATABASE_URL=file:./dev.db
# Prod : utiliser Postgres avec un schéma Prisma dédié et une migration validée
# DATABASE_URL=postgresql://mbolo:password@host:5432/mbolo_tv

# Stockage
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
# Prod : passer à S3 (Cloudflare R2, AWS S3, MinIO...)
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://account.r2.cloudflarestorage.com
# S3_ACCESS_KEY=change-me
# S3_SECRET_KEY=change-me
# S3_BUCKET=mbolo-assets
# S3_REGION=auto
# Durée des URLs signées des logos S3, en secondes
S3_LOGO_URL_TTL_SECONDS=300

# Files d'attente
QUEUE_DRIVER=inprocess
# Prod : BullMQ sur Redis managé (Upstash...)
# QUEUE_DRIVER=bullmq
# REDIS_URL=rediss://default:password@host:6379

# Intégrations optionnelles — ne jamais exposer les identifiants fournisseurs au navigateur
SPORTS_DATA_PROVIDER_URL=
SPORTS_DATA_PROVIDER_KEY=

# Console propriétaire — valeur privée, ne pas rendre publique ni versionner en production
OWNER_CONSOLE_PATH=/control/change-this-private-path

# Authentification owner
OWNER_EMAIL=owner@example.com
# Obligatoire pour le premier provisionnement, ne pas committer une vraie valeur
OWNER_PASSWORD=change-this-password-in-secret-manager
OWNER_SESSION_TTL_MINUTES=15
OWNER_SESSION_ABSOLUTE_TTL_HOURS=8
OWNER_LOGIN_MAX_ATTEMPTS=5
OWNER_LOGIN_MAX_PER_IP=20
ZERO_TRUST_AUDIENCE=

# Streaming — gateway à sessions
PUBLIC_API_URL=http://localhost:4000
STREAM_IDLE_TTL_MINUTES=240
STREAM_ABSOLUTE_TTL_HOURS=24
STREAM_ALIAS_TTL_HOURS=6
STREAM_ALLOWED_HOSTS=
STREAM_MAX_PLAYLIST_BYTES=2097152
STREAM_PLAYLIST_STALE_TTL_MS=25000
STREAM_SEGMENT_CACHE_MAX_BYTES=134217728

# Import — les playlists sont lues en streaming, mais les entrées sont normalisées par lots
IMPORT_MAX_BYTES=536870912
IMPORT_FETCH_TIMEOUT_MS=300000
IMPORT_SUBPLAYLIST_PROBE=false
IMPORT_LOGO_TIMEOUT_MS=8000
IMPORT_LOGO_MAX_BYTES=524288
IMPORT_LOGO_MAX_DOWNLOADS=50000

# Health-check des flux
HEALTH_CHECK_STALE_MINUTES=30
HEALTH_CHECK_TIMEOUT_MS=6000
HEALTH_CHECK_BATCH_SIZE=10
HEALTH_CHECK_RECENT_DAYS=7
HEALTH_CHECK_CRON=*/10 * * * *

# EPG
EPG_MAX_BYTES=536870912

# Matchs
MATCH_DETECTION_ENABLED=true
MATCH_PAST_HOURS=6
MATCH_LOOKAHEAD_HOURS=48
