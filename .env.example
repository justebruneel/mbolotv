# Application
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000

# Sécurité
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ENCRYPTION_KEY=32-byte-base64-key-change-me

# Base de données
# DATABASE_URL peut rester poolée pour l’application.
DATABASE_URL=postgresql://user:password@host-pooler/mbolo?sslmode=require
# DIRECT_URL est utilisée par Prisma Migrate. Sur Neon: même URL, mais sans -pooler.
# DIRECT_URL=postgresql://user:password@host/mbolo?sslmode=require

# Stockage des logos et playlists
# local pour le dev, cloudinary pour les logos en production
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
# STORAGE_DRIVER=cloudinary
# CLOUDINARY_CLOUD_NAME=change-me
# CLOUDINARY_API_KEY=change-me
# CLOUDINARY_API_SECRET=change-me
# CLOUDINARY_FOLDER=mbolo-tv
# STORAGE_DRIVER=s3 reste supporté si nécessaire
# S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
# S3_ACCESS_KEY=change-me
# S3_SECRET_KEY=change-me
# S3_BUCKET=mbolo
# S3_REGION=us-east-1
S3_LOGO_URL_TTL_SECONDS=300

# Files d'attente
# QUEUE_INTERNAL_SECRET=change-this-in-secret-manager

# Console propriétaire
OWNER_CONSOLE_PATH=/control/change-this-private-path
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-this-password-in-secret-manager
OWNER_SESSION_TTL_MINUTES=15
OWNER_SESSION_ABSOLUTE_TTL_HOURS=8
OWNER_LOGIN_MAX_ATTEMPTS=5
OWNER_LOGIN_MAX_PER_IP=20
ZERO_TRUST_AUDIENCE=

# CORS API production
CORS_MODE=permissive
# CORS_ALLOWED_ORIGINS=https://votre-frontend.vercel.app,https://votre-domaine.com

# Streaming
PUBLIC_API_URL=http://localhost:4000
# Proxy vidéo edge (Cloudflare Worker) : si défini, les URLs de lecture pointent
# directement vers le Worker (?url=<source encodée>&x-exp=…&x-sig=…) et ne passent
# plus par l'API. Le proxy ne sert que des URL signées : PROXY_URL_SECRET doit
# être identique à celui du worker proxy (voir docs/security/proxy-url-signature.md).
VIDEO_PROXY_URL=
PROXY_URL_SECRET=
STREAM_SESSION_STORE=memory
STREAM_PLAYLIST_CACHE=memory
STREAM_PLAYLIST_CACHE_MAX_ENTRIES=1000
STREAM_IDLE_TTL_MINUTES=240
STREAM_ABSOLUTE_TTL_HOURS=24
STREAM_ALIAS_TTL_HOURS=6
STREAM_ALLOWED_HOSTS=
STREAM_MAX_PLAYLIST_BYTES=2097152
STREAM_PLAYLIST_STALE_TTL_MS=25000
STREAM_SEGMENT_CACHE_MAX_BYTES=134217728

# Imports
IMPORT_MAX_BYTES=536870912
IMPORT_FETCH_TIMEOUT_MS=300000
IMPORT_SUBPLAYLIST_PROBE=false
IMPORT_LOGO_TIMEOUT_MS=8000
IMPORT_LOGO_MAX_BYTES=524288
IMPORT_LOGO_MAX_DOWNLOADS=50000

# Health-check
HEALTH_CHECK_STALE_MINUTES=30
HEALTH_CHECK_TIMEOUT_MS=6000
HEALTH_CHECK_BATCH_SIZE=10
HEALTH_CHECK_RECENT_DAYS=7
HEALTH_CHECK_CRON=*/10 * * * *

# EPG et matchs
EPG_MAX_BYTES=536870912
# Fournisseurs EPG complémentaires (gratuits, voir docs/epg.md)
EPG_XMLTVFR_URL=https://xmltvfr.fr/xmltv.xml.gz
EPG_IPTV_EPG_FR_URL=https://iptv-epg.org/files/epg-fr.xml.gz
# Liste d'URLs EPG Afrique (séparées par virgule, ex: NG,ZA,CI via globetvapp ou iptv-epg.org)
EPG_AFRICA_URLS=
EPG_EXTRA_URLS=
# TMDB (enrichissement affiches/backdrops/bandes-annonces) — https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_READ_TOKEN=
MATCH_DETECTION_ENABLED=true
MATCH_PAST_HOURS=6
MATCH_LOOKAHEAD_HOURS=48
