# Application
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000

# Sécurité — remplacer ces valeurs hors développement
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ENCRYPTION_KEY=32-byte-base64-key-change-me

# Base de données
# Dev : SQLite, aucune infrastructure requise
DATABASE_URL=file:./dev.db
# Prod (optionnel) : basculer vers Postgres managé (Neon, Supabase...)
# DATABASE_URL=postgresql://mbolo:password@host:5432/mbolo_tv

# Stockage
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
# Prod : passer à S3 (Cloudflare R2, AWS S3, MinIO...)
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://account.r2.cloudflarestorage.com
# S3_ACCESS_KEY=change-me
# S3_SECRET_KEY=change-me
# S3_BUCKET=mbolo-assets
# S3_REGION=auto

# Files d'attente
QUEUE_DRIVER=inprocess
# Prod : BullMQ sur Redis managé (Upstash...)
# QUEUE_DRIVER=bullmq
# REDIS_URL=rediss://default:password@host:6379

# Intégrations optionnelles — ne jamais exposer les identifiants fournisseurs au navigateur
SPORTS_DATA_PROVIDER_URL=
SPORTS_DATA_PROVIDER_KEY=

# Console propriétaire — valeur privée, ne pas rendre publique ni versionner en production
OWNER_CONSOLE_PATH=/control/change-this-private-path

# Authentification owner et Zero-Trust
OWNER_EMAIL=owner@example.com
OWNER_SESSION_TTL_MINUTES=15
OWNER_SESSION_ABSOLUTE_TTL_HOURS=8
TOTP_ISSUER=Mbolo TV Control
ZERO_TRUST_AUDIENCE=

# Streaming — gateway à sessions
# Base publique de l'API construisant les URL de lecture renvoyées au navigateur
PUBLIC_API_URL=http://localhost:4000
# TTL d'inactivité d'une session de lecture (glissant) puis plafond absolu
STREAM_IDLE_TTL_MINUTES=240
STREAM_ABSOLUTE_TTL_HOURS=24
# TTL des alias de contenu (segments, clés, sous-playlists)
STREAM_ALIAS_TTL_HOURS=6
# Hôtes CDN autorisés en plus du domaine source (séparés par des virgules)
STREAM_ALLOWED_HOSTS=
# Taille max d'une playlist fournisseur à réécrire (octets)
STREAM_MAX_PLAYLIST_BYTES=2097152
# Durée pendant laquelle on resert la dernière playlist valide en cas de pépin fournisseur (ms)
STREAM_PLAYLIST_STALE_TTL_MS=25000

# Import — détection des sous-playlists imbriquées (dossiers de chaînes) en
# sondant chaque entrée. Coûteux sur les gros imports : off par défaut.
# IMPORT_SUBPLAYLIST_PROBE=false

# Health-check des flux — vérification d'état des variantes
# Délai après lequel un statut est considéré comme obsolète
HEALTH_CHECK_STALE_MINUTES=30
# Délai max d'une requête de sonde (ms)
HEALTH_CHECK_TIMEOUT_MS=6000
# Nombre de variantes récemment regardées à vérifier par passage
HEALTH_CHECK_BATCH_SIZE=10
# Période pendant laquelle une variante reste éligible au scan (jours)
HEALTH_CHECK_RECENT_DAYS=7
# Fréquence du scan d'arrière-plan (cron)
HEALTH_CHECK_CRON=*/10 * * * *

# EPG — import XMLTV (cron quotidien à 5h, réglable)
# Taille max d'un flux XMLTV téléchargé (octets)
EPG_MAX_BYTES=536870912
