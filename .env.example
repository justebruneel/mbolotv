# Application
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000

# Sécurité — remplacer ces valeurs hors développement
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ENCRYPTION_KEY=32-byte-base64-key-change-me

# Base de données
# Dev : SQLite, aucune infrastructure requise
DATABASE_URL=file:./dev.db
# Prod (optionnel) : basculer vers Postgres managé (Neon, Supabase...)
# DATABASE_URL=postgresql://mbolo:password@host:5432/mbolo_tv

# Stockage
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
# Prod : passer à S3 (Cloudflare R2, AWS S3, MinIO...)
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://account.r2.cloudflarestorage.com
# S3_ACCESS_KEY=change-me
# S3_SECRET_KEY=change-me
# S3_BUCKET=mbolo-assets
# S3_REGION=auto

# Files d'attente
QUEUE_DRIVER=inprocess
# Prod : BullMQ sur Redis managé (Upstash...)
# QUEUE_DRIVER=bullmq
# REDIS_URL=rediss://default:password@host:6379

# Intégrations optionnelles — ne jamais exposer les identifiants fournisseurs au navigateur
SPORTS_DATA_PROVIDER_URL=
SPORTS_DATA_PROVIDER_KEY=

# Console propriétaire — valeur privée, ne pas rendre publique ni versionner en production
OWNER_CONSOLE_PATH=/control/change-this-private-path

# Authentification owner et Zero-Trust
OWNER_EMAIL=owner@example.com
OWNER_SESSION_TTL_MINUTES=15
OWNER_SESSION_ABSOLUTE_TTL_HOURS=8
TOTP_ISSUER=Mbolo TV Control
ZERO_TRUST_AUDIENCE=
