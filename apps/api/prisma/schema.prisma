generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Variable d'environnement : URL de connexion PostgreSQL (Neon, Supabase...).
  // En local : postgresql://user:pass@host:5432/mbolo_tv (voir apps/api/.env).
  url = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())
  email String @unique
  role String @default("USER")
  passwordHash String?
  whatsappContact String?
  createdAt DateTime @default(now())
  profiles Profile[]
  sources Source[]
  auditLogs AuditLog[]
  ownerSessions OwnerSession[]
  accessCodes AccessCode[]
}
model Profile {
  id String @id @default(cuid())
  userId String
  name String
  settings Json?
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@index([userId])
}
model Source {
  id String @id @default(cuid())
  ownerId String
  name String
  kind String
  status String @default("PENDING")
  priority Int @default(100)
  connectionEncrypted Bytes
  epgUrl String?
  lastSyncedAt DateTime?
  createdAt DateTime @default(now())
  owner User @relation(fields:[ownerId], references:[id], onDelete:Cascade)
  importRuns ImportRun[]
  variants StreamVariant[]
  @@index([ownerId, status])
}
model ImportRun {
  id String @id @default(cuid())
  sourceId String
  state String @default("QUEUED")
  metrics Json?
  errorCode String?
  errorMessage String?
  startedAt DateTime @default(now())
  completedAt DateTime?
  source Source @relation(fields:[sourceId], references:[id], onDelete:Cascade)
  @@index([sourceId, startedAt])
}
model Category {
  id String @id @default(cuid())
  slug String @unique
  name String
  sortOrder Int @default(0)
  isVisible Boolean @default(true)
  parentId String?
  parent Category? @relation("CategoryTree", fields:[parentId], references:[id])
  children Category[] @relation("CategoryTree")
  channels Channel[]
  @@index([parentId, isVisible])
}
model Channel {
  id String @id @default(cuid())
  name String
  canonicalName String
  normalizedKey String @unique
  tvgId String?
  country String?
  logoKey String?
  categoryId String?
  sortOrder Int @default(0)
  isVisible Boolean @default(true)
  createdAt DateTime @default(now())
  category Category? @relation(fields:[categoryId], references:[id])
  variants StreamVariant[]
  programmes EpgProgramme[]
  favorites Favorite[]
  epgMappings ChannelEpgMapping[]
  @@index([categoryId, isVisible])
  @@index([tvgId])
}
model StreamVariant {
  id String @id @default(cuid())
  channelId String
  sourceId String
  encryptedLocator Bytes
  quality String?
  healthScore Float @default(0)
  healthStatus String?
  healthCheckedAt DateTime?
  lastPlayedAt DateTime?
  isActive Boolean @default(true)
  channel Channel @relation(fields:[channelId], references:[id], onDelete:Cascade)
  source Source @relation(fields:[sourceId], references:[id], onDelete:Cascade)
  matchStreams MatchStream[]
  @@index([channelId, isActive, healthScore])
  @@index([lastPlayedAt])
}
model EpgProgramme {
  id String @id @default(cuid())
  channelId String
  startsAt DateTime
  endsAt DateTime
  title String
  description String?
  imageUrl String?
  metadata Json?
  channel Channel @relation(fields:[channelId], references:[id], onDelete:Cascade)
  @@index([channelId, startsAt])
}
model Match {
  id String @id @default(cuid())
  sport String
  competition String
  homeTeam String
  awayTeam String
  startsAt DateTime
  endsAt DateTime?
  state String @default("SCHEDULED")
  // ExternalId de la source d'agenda (ex: TheSportsDB "event-2494027") :
  // idempotence des imports d'agenda. Null = match découvert via l'EPG.
  externalId String? @unique
  // Logo des équipes fourni par l'agenda (ex: badges TheSportsDB).
  homeTeamLogo String?
  awayTeamLogo String?
  matchStreams MatchStream[]
  @@index([state, startsAt])
}
model MatchStream {
  id String @id @default(cuid())
  matchId String
  streamVariantId String
  priority Int @default(100)
  healthScore Float @default(0)
  match Match @relation(fields:[matchId], references:[id], onDelete:Cascade)
  streamVariant StreamVariant @relation(fields:[streamVariantId], references:[id], onDelete:Cascade)
  @@unique([matchId, streamVariantId])
}
model Favorite {
  deviceId  String
  channelId String
  createdAt DateTime @default(now())
  channel   Channel @relation(fields:[channelId], references:[id], onDelete:Cascade)

  @@id([deviceId, channelId])
  @@index([deviceId, createdAt])
}
model AuditLog {
  id String @id @default(cuid())
  actorId String?
  action String
  entity String
  entityId String?
  metadata Json?
  createdAt DateTime @default(now())
  actor User? @relation(fields:[actorId], references:[id], onDelete:SetNull)
  @@index([entity, entityId])
  @@index([actorId, createdAt])
}
model OwnerSession {
  id String @id @default(cuid())
  userId String
  userAgent String?
  ipHash String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@index([userId, expiresAt])
}
model AccessCode {
  id String @id @default(cuid())
  codeHash String @unique
  codeLast4 String
  kind String @default("STANDARD")
  durationHours Int
  maxDevices Int @default(1)
  active Boolean @default(true)
  createdById String
  createdAt DateTime @default(now())
  revokedAt DateTime?
  createdBy User @relation(fields:[createdById], references:[id], onDelete:Cascade)
  grant DeviceGrant?
  @@index([createdById, active])
}
model DeviceGrant {
  id String @id @default(cuid())
  accessCodeId String @unique
  deviceHash String
  userAgent String?
  ipHash String?
  grantedAt DateTime @default(now())
  expiresAt DateTime
  lastSeenAt DateTime @default(now())
  accessCode AccessCode @relation(fields:[accessCodeId], references:[id], onDelete:Cascade)
  @@index([deviceHash, expiresAt])
}
// Cache d'enrichissement EPG (TVmaze + Fanart.tv, ex-TmdbCache).
// payload = MetadataEnriched ; clé "titre normalisé::année" ; TTL 30 jours.
model MetadataCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  title     String
  year      Int?
  payload   Json
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
  @@index([title])
}
model ChannelEpgMapping {
  id String @id @default(cuid())
  channelId String
  provider String
  externalId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  channel Channel @relation(fields:[channelId], references:[id], onDelete:Cascade)
  @@unique([channelId, provider])
  @@index([provider, externalId])
}

model PushSubscription {
  id String @id @default(cuid())
  deviceId String
  endpoint String @unique
  p256dh String
  auth String
  createdAt DateTime @default(now())
  @@index([deviceId])
}

model ProgrammeReminder {
  deviceId String
  programmeId String
  channelId String
  channelName String
  title String
  startsAt DateTime
  endsAt DateTime
  fired Boolean @default(false)
  createdAt DateTime @default(now())
  @@id([deviceId, programmeId])
  @@index([startsAt, fired])
}

model Announcement {
  id String @id @default(cuid())
  title String
  body String
  kind String @default("INFO")
  status String @default("DRAFT")
  createdAt DateTime @default(now())
  sentAt DateTime?
  @@index([status, createdAt])
}
