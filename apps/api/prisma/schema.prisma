generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Variable d'environnement : URL de connexion PostgreSQL (Neon, Supabase...).
  // En local : postgresql://user:pass@host:5432/mbolo_tv (voir apps/api/.env).
  url = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())
  email String @unique
  role String @default("USER")
  passwordHash String?
  whatsappContact String?
  createdAt DateTime @default(now())
  profiles Profile[]
  sources Source[]
  auditLogs AuditLog[]
  ownerSessions OwnerSession[]
  accessCodes AccessCode[]
}
model Profile {
  id String @id @default(cuid())
  userId String
  name String
  settings Json?
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@index([userId])
}
model Source {
  id String @id @default(cuid())
  ownerId String
  name String
  kind String
  status String @default("PENDING")
  priority Int @default(100)
  connectionEncrypted Bytes
  epgUrl String?
  // Importer aussi films/séries (Xtream : get_vod_streams + get_series).
  vodEnabled Boolean @default(false)
  lastSyncedAt DateTime?
  createdAt DateTime @default(now())
  owner User @relation(fields:[ownerId], references:[id], onDelete:Cascade)
  importRuns ImportRun[]
  variants StreamVariant[]
  vodItems VodItem[]
  @@index([ownerId, status])
}
model ImportRun {
  id String @id @default(cuid())
  sourceId String
  state String @default("QUEUED")
  // Périmètre de l'import : "live" (chaînes), "vod" (films/séries sans les
  // chaînes), "all" (les deux). Les chaînes gardent leur import individuel.
  scope String @default("all")
  metrics Json?
  errorCode String?
  errorMessage String?
  startedAt DateTime @default(now())
  completedAt DateTime?
  source Source @relation(fields:[sourceId], references:[id], onDelete:Cascade)
  @@index([sourceId, startedAt])
}
model Category {
  id String @id @default(cuid())
  slug String @unique
  name String
  sortOrder Int @default(0)
  isVisible Boolean @default(true)
  parentId String?
  parent Category? @relation("CategoryTree", fields:[parentId], references:[id])
  children Category[] @relation("CategoryTree")
  channels Channel[]
  @@index([parentId, isVisible])
}
model Channel {
  id String @id @default(cuid())
  name String
  canonicalName String
  normalizedKey String @unique
  tvgId String?
  country String?
  logoKey String?
  categoryId String?
  sortOrder Int @default(0)
  isVisible Boolean @default(true)
  createdAt DateTime @default(now())
  category Category? @relation(fields:[categoryId], references:[id])
  variants StreamVariant[]
  programmes EpgProgramme[]
  favorites Favorite[]
  epgMappings ChannelEpgMapping[]
  @@index([categoryId, isVisible])
  @@index([tvgId])
}
model StreamVariant {
  id String @id @default(cuid())
  channelId String
  sourceId String
  encryptedLocator Bytes
  quality String?
  healthScore Float @default(0)
  healthStatus String?
  healthCheckedAt DateTime?
  lastPlayedAt DateTime?
  isActive Boolean @default(true)
  channel Channel @relation(fields:[channelId], references:[id], onDelete:Cascade)
  source Source @relation(fields:[sourceId], references:[id], onDelete:Cascade)
  matchStreams MatchStream[]
  @@index([channelId, isActive, healthScore])
  @@index([lastPlayedAt])
}
model EpgProgramme {
  id String @id @default(cuid())
  channelId String
  startsAt DateTime
  endsAt DateTime
  title String
  description String?
  imageUrl String?
  metadata Json?
  channel Channel @relation(fields:[channelId], references:[id], onDelete:Cascade)
  @@index([channelId, startsAt])
}
model Match {
  id String @id @default(cuid())
  sport String
  competition String
  homeTeam String
  awayTeam String
  startsAt DateTime
  endsAt DateTime?
  state String @default("SCHEDULED")
  // ExternalId de la source d'agenda (ex: TheSportsDB "event-2494027") :
  // idempotence des imports d'agenda. Null = match découvert via l'EPG.
  externalId String? @unique
  // Logo des équipes fourni par l'agenda (ex: badges TheSportsDB).
  homeTeamLogo String?
  awayTeamLogo String?
  matchStreams MatchStream[]
  @@index([state, startsAt])
}
model MatchStream {
  id String @id @default(cuid())
  matchId String
  streamVariantId String
  priority Int @default(100)
  healthScore Float @default(0)
  match Match @relation(fields:[matchId], references:[id], onDelete:Cascade)
  streamVariant StreamVariant @relation(fields:[streamVariantId], references:[id], onDelete:Cascade)
  @@unique([matchId, streamVariantId])
}
model Favorite {
  deviceId  String
  channelId String
  createdAt DateTime @default(now())
  channel   Channel @relation(fields:[channelId], references:[id], onDelete:Cascade)

  @@id([deviceId, channelId])
  @@index([deviceId, createdAt])
}
// VOD (films/séries) importée depuis les sources Xtream (vodEnabled).
// kind : "MOVIE" (locator = /movie/...) ou "SERIES" (locator = JSON
// xtream-series ; épisodes résolus à la lecture via get_series_info).
model VodItem {
  id String @id @default(cuid())
  kind String
  title String
  normalizedKey String @unique
  posterUrl String?
  // Synopsis du fournisseur (Xtream plot / M3U à venir) : la source de
  // vérité ; TVmaze/TMDB ne servent qu'en secours à l'affichage.
  description String?
  rating Float?
  categoryTitle String?
  // Clé normalisée (trim+lowercase) du categoryTitle fournisseur : c'est elle
  // que matchent les règles de dossiers VOD (les libellés bruts varient en casse/espaces).
  categoryKey String?
  containerExt String?
  addedAt DateTime?
  sourceId String
  encryptedLocator Bytes
  isActive Boolean @default(true)
  isVisible Boolean @default(true)
  createdAt DateTime @default(now())
  source Source @relation(fields:[sourceId], references:[id], onDelete:Cascade)
  favorites VodFavorite[]
  folders VodFolderItem[]
  @@index([kind, categoryTitle, isActive])
  @@index([kind, categoryKey, isActive])
  @@index([sourceId, isActive])
}
model VodFavorite {
  deviceId  String
  vodItemId String
  createdAt DateTime @default(now())
  vodItem   VodItem @relation(fields:[vodItemId], references:[id], onDelete:Cascade)

  @@id([deviceId, vodItemId])
  @@index([deviceId, createdAt])
}
// ---- Catalogue VOD administrable (console propriétaire) ----
// Dossiers vidéo en arbre — miroir de Category mais indépendant du live.
// kind : MOVIE | SERIES | BOTH (un dossier mixte apparaît dans les deux onglets).
model VodFolder {
  id String @id @default(cuid())
  slug String @unique
  name String
  kind String @default("BOTH")
  sortOrder Int @default(0)
  isVisible Boolean @default(true)
  parentId String?
  parent VodFolder? @relation("VodFolderTree", fields:[parentId], references:[id])
  children VodFolder[] @relation("VodFolderTree")
  rules VodFolderRule[]
  items VodFolderItem[]
  youtubeSources VodYoutubeSource[]
  @@index([parentId, isVisible])
  @@index([kind, isVisible])
}
// Règle automatique : un categoryTitle fournisseur (clé normalisée) alimente ce dossier.
// La même clé peut nourrir plusieurs dossiers (un item dans 2 rails) — voulu.
model VodFolderRule {
  id String @id @default(cuid())
  folderId String
  categoryKey String
  // Libellé d'origine, rien que pour l'affichage en console.
  categoryTitle String
  folder VodFolder @relation(fields:[folderId], references:[id], onDelete:Cascade)
  @@unique([folderId, categoryKey])
  @@index([categoryKey])
}
// Affectation manuelle item ↔ dossier (N-N ; beaucoup d'items).
model VodFolderItem {
  folderId String
  vodItemId String
  createdAt DateTime @default(now())
  folder VodFolder @relation(fields:[folderId], references:[id], onDelete:Cascade)
  vodItem VodItem @relation(fields:[vodItemId], references:[id], onDelete:Cascade)
  @@id([folderId, vodItemId])
  @@index([vodItemId])
}
// Chaîne YouTube rattachée à un dossier — remplace l'allowlist statique en env.
model VodYoutubeSource {
  id String @id @default(cuid())
  folderId String
  channelId String
  label String?
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  folder VodFolder @relation(fields:[folderId], references:[id], onDelete:Cascade)
  @@unique([folderId, channelId])
  @@index([channelId, isActive])
}
// ---- Titres externes (lecteurs tiers Mixdrop/Dood/Voe/Uqload, sans pubs) ----
// Titre importé depuis une fiche (French Stream, …) : métas + N lecteurs.
// Catalogue global comme VodFolder (pas d'ownerId) ; la lecture passe par
// /api/x/play (résolution au clic, jamais de lien direct stocké).
model ExternalTitle {
  id String @id @default(cuid())
  site String
  siteRef String?
  title String
  // MOVIE | SERIES : posé par l'import (le bot pré-classe via le listing).
  kind String @default("MOVIE")
  year Int?
  posterUrl String?
  backdropUrl String?
  trailerYoutubeId String?
  // Détails « façon Netflix » extraits par le scraper (tout null-able : la
  // fiche source ne les fournit pas toujours ; l'UI masque ce qui manque).
  synopsis String?
  originalTitle String?
  duration String?
  director String?
  cast String?
  genres String[] @default([])
  // URL de la fiche d'origine : sert au re-scrapping des titres déjà publiés.
  ficheUrl String?
  // Fenêtre d'intro (secondes) saisie en console : le Player affiche
  // « Sauter l'intro » quand la position est dans [début, fin).
  introStartSec Float?
  introEndSec Float?
  isVisible Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  sources ExternalSource[]
  @@unique([site, siteRef])
  @@index([isVisible, sortOrder])
}
// Un lecteur tiers d'un titre : embed d'origine (+ finale après wrapper).
// lastStatus : UNKNOWN (jamais vérifié) | OK | DEAD | ERROR.
model ExternalSource {
  id String @id @default(cuid())
  titleId String
  host String
  // direct = résolu par un extracteur (/api/x/play) ; iframe = embed lu tel
  // quel dans une iframe en attendant son extracteur.
  mode String @default("direct")
  embedUrl String
  finalUrl String?
  versions String[] @default([])
  sortOrder Int @default(0)
  isActive Boolean @default(true)
  lastStatus String @default("UNKNOWN")
  lastError String?
  lastCheckedAt DateTime?
  createdAt DateTime @default(now())
  title ExternalTitle @relation(fields:[titleId], references:[id], onDelete:Cascade)
  @@unique([titleId, host, embedUrl])
  @@index([isActive, lastCheckedAt])
}

// File d'attente du bot d'import automatique (fiches French Stream) : chaque
// ligne = une fiche découverte dans un listing, à publier par petits lots à
// chaque tick du cron. kind posé à la découverte (films→MOVIE, s-tv→SERIES).
model ExternalImportQueue {
  id String @id @default(cuid())
  site String @default("frenchstream")
  category String
  newsid String
  kind String @default("MOVIE")
  state String @default("PENDING")
  priority Int @default(0)
  attempts Int @default(0)
  lastError String?
  discoveredAt DateTime @default(now())
  processedAt DateTime?
  @@unique([site, newsid])
  @@index([state, priority(sort: Desc), attempts, discoveredAt])
}
model AuditLog {
  id String @id @default(cuid())
  actorId String?
  action String
  entity String
  entityId String?
  metadata Json?
  createdAt DateTime @default(now())
  actor User? @relation(fields:[actorId], references:[id], onDelete:SetNull)
  @@index([entity, entityId])
  @@index([actorId, createdAt])
}
model OwnerSession {
  id String @id @default(cuid())
  userId String
  userAgent String?
  ipHash String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@index([userId, expiresAt])
}
model AccessCode {
  id String @id @default(cuid())
  codeHash String @unique
  codeLast4 String
  kind String @default("STANDARD")
  durationHours Int
  maxDevices Int @default(1)
  active Boolean @default(true)
  createdById String
  createdAt DateTime @default(now())
  revokedAt DateTime?
  createdBy User @relation(fields:[createdById], references:[id], onDelete:Cascade)
  grant DeviceGrant?
  @@index([createdById, active])
}
model DeviceGrant {
  id String @id @default(cuid())
  accessCodeId String @unique
  deviceHash String
  userAgent String?
  ipHash String?
  grantedAt DateTime @default(now())
  expiresAt DateTime
  lastSeenAt DateTime @default(now())
  accessCode AccessCode @relation(fields:[accessCodeId], references:[id], onDelete:Cascade)
  @@index([deviceHash, expiresAt])
}
// Cache d'enrichissement EPG (TVmaze + Fanart.tv, ex-TmdbCache).
// payload = MetadataEnriched ; clé "titre normalisé::année" ; TTL 30 jours.
model MetadataCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  title     String
  year      Int?
  payload   Json
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
  @@index([title])
}
model ChannelEpgMapping {
  id String @id @default(cuid())
  channelId String
  provider String
  externalId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  channel Channel @relation(fields:[channelId], references:[id], onDelete:Cascade)
  @@unique([channelId, provider])
  @@index([provider, externalId])
}

model PushSubscription {
  id String @id @default(cuid())
  deviceId String
  endpoint String @unique
  p256dh String
  auth String
  createdAt DateTime @default(now())
  @@index([deviceId])
}

model ProgrammeReminder {
  deviceId String
  programmeId String
  channelId String
  channelName String
  title String
  startsAt DateTime
  endsAt DateTime
  fired Boolean @default(false)
  createdAt DateTime @default(now())
  @@id([deviceId, programmeId])
  @@index([startsAt, fired])
}

model Announcement {
  id String @id @default(cuid())
  title String
  body String
  kind String @default("INFO")
  status String @default("DRAFT")
  createdAt DateTime @default(now())
  sentAt DateTime?
  @@index([status, createdAt])
}
