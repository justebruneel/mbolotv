API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
OWNER_CONSOLE_PATH=/control/change-this-private-path
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# --- MeshStream (ADR-0004, production v1) ----------------------------------
# NEXT_PUBLIC_MESH_ENABLED=1 : autorise le web à monter la session mesh quand
# /play renvoie p2p:true. Sans ce flag, le code @mbolo/mesh n'est même pas
# téléchargé (import dynamique court-circuité) : streaming strictement actuel.
# (Legacy : NEXT_PUBLIC_MESH_POC=1 reste accepté en repli.)
# PRODUCTION : poser NEXT_PUBLIC_MESH_ENABLED=1 dans l'env Vercel de prod.
# NEXT_PUBLIC_MESH_STUN : STUN configurables (TURN non déployé en v1).
# NEXT_PUBLIC_MESH_ENABLED=
# NEXT_PUBLIC_MESH_STUN=stun:stun.l.google.com:19302
