API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
OWNER_CONSOLE_PATH=/control/change-this-private-path
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# --- MeshStream POC (ADR-0004 étape 4) + canary privé (étape 6) — DÉSACTIVÉ par défaut
# NEXT_PUBLIC_MESH_POC=1 : autorise le web à monter la session mesh quand
# /play renvoie p2p:true. Sans ce flag, le code @mbolo/mesh n'est même pas
# téléchargé (import dynamique court-circuité) : streaming strictement actuel.
# CANARY : ce flag ne doit être posé QUE sur un preview de test (jamais la
# prod). L'activation par testeur est décidée SERVEUR (MESH_TESTER_ALLOWLIST
# sur l'API de test) : un front canary + un testeur hors liste = p2p:false.
# NEXT_PUBLIC_MESH_STUN : STUN configurables (jamais de TURN à cette étape).
# NEXT_PUBLIC_MESH_POC=
# NEXT_PUBLIC_MESH_STUN=stun:stun.l.google.com:19302
